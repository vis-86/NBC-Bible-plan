# Copy to deploy/.env on the server and fill secrets (NEVER commit deploy/.env).
# Secrets are generated on the server during setup.

# --- Postgres ---
PG_PASSWORD=changeme

# --- Directus core ---
DIRECTUS_KEY=changeme-uuid
DIRECTUS_SECRET=changeme-random
DIRECTUS_ADMIN_EMAIL=admin@baptistnn.ru
DIRECTUS_ADMIN_PASSWORD=changeme-strong
DIRECTUS_PUBLIC_URL=https://bible.baptistnn.ru/directus
# Static token created in Directus after first boot (Phase 2.9)
DIRECTUS_ADMIN_TOKEN=

# --- App (Next.js) ---
NEXT_PUBLIC_BASE_PATH=/app
# Public URL the browser/app uses to reach Directus (through nginx)
NEXT_PUBLIC_DIRECTUS_URL=https://bible.baptistnn.ru/directus
NEXT_PUBLIC_AI_ENABLE=
NEXT_PUBLIC_DIRECTUS_AI_FLOW_ID=ai-service
TELEGRAM_BOT_TOKEN=
JWT_SECRET=changeme-random

# --- Self-registration по коду церкви (включать ОБА вместе) ---
# Server-only секрет (runtime, меняется без пересборки). Пусто ⇒ регистрация выключена (503).
REGISTER_CHURCH_CODE=
# Клиентский UI-флаг (build-time, инлайнится в бандл ⇒ тоггл требует пересборки образа). 'true'/'1' включает CTA.
NEXT_PUBLIC_REGISTER_ENABLED=
