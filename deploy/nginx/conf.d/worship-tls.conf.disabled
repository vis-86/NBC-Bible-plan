# Витрина worship (песни и сеты для музыкальных команд) — HTTPS-блок song.apps7.ru: та же
# статика из второго билда (/usr/share/nginx/html-worship) и тот же BFF.
#
# Включение — ПОСЛЕ выпуска сертификата для song.apps7.ru (HTTP-01 обслуживает
# worship-http.conf) и после деплоя образа со второй сборкой:
#   mv worship-tls.conf.disabled worship-tls.conf  &&  docker compose exec nginx nginx -t  &&  docker compose exec nginx nginx -s reload
# Пока файл *.disabled, nginx его не читает. Без сертификата nginx с этим блоком не
# стартует (упадёт и NBC); без образа со второй сборкой витрина отдаёт 404.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name song.apps7.ru;

    ssl_certificate     /etc/letsencrypt/live/song.apps7.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/song.apps7.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 25m;
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Тот же BFF, что у основного приложения (сессия — cookie хоста, домены изолированы).
    location /app/api/ {
        set $up_bff bff;
        proxy_pass http://$up_bff:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /app/sw.js {
        root /usr/share/nginx/html-worship;
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    location /app/_next/static/ {
        root /usr/share/nginx/html-worship;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /app/manifest.webmanifest {
        root /usr/share/nginx/html-worship;
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    location /app {
        root /usr/share/nginx/html-worship;
        try_files $uri $uri.html $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    location = / {
        return 302 /app;
    }
}
