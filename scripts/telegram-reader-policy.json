    "read": {
      "policy": {
        "name": "custom",
        "rules": {
          "directus_user_id": {
            "_eq": "$CURRENT_USER"
          }
        }
      },
      "fields": ["*"]
    },
    "update": {
      "policy": {
        "name": "custom",
        "rules": {
          "directus_user_id": {
            "_eq": "$CURRENT_USER"
          }
        }
      },
      "fields": ["*"]
    },
    "delete": {
      "policy": {
        "name": "custom",
        "rules": {
          "directus_user_id": {
            "_eq": "$CURRENT_USER"
          }
        }
      },
      "fields": ["*"]
    }
  },
  "weeks": {
    "read": {
      "policy": {
        "name": "full"
      },
      "fields": ["*"]
    }
  },
  "directus_users": {
    "read": {
      "policy": {
        "name": "custom",
        "rules": {
          "id": {
            "_eq": "$CURRENT_USER"
